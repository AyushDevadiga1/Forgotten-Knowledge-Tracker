{
  "manifest_version": 3,
  "name": "FKT Capture",
  "version": "1.0.0",
  "description": "Send selected study text from any tab to the Forgotten Knowledge Tracker dashboard (/api/v1/ingest).",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FKT Capture"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
